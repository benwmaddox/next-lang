fn make(value: long) -> Wide { Wide { f0: value, f519: value } }
fn last(value: Wide) -> long { value.f519 }
fn main() {
    let outer = make(11L)
    {
        let inner = make(22L)
        print(last(inner))
    }
    print(last(outer))
}
