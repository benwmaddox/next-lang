// Decimal text for doubles. str_fixed is emitted here as LLVM IR (no C): exact round-half-even on the double true
// value (|x| < 2^63, up to 19 digits, 128-bit integer arithmetic). Shortest round-trip printing of double and float
// and correctly rounded parse_double are plain next-lang in core/float_decimal.nl (exact big integers, no floating
// point); the internal wrappers below give them scratch stack memory and move bits across the double/integer edge.
// All only emitted for the C runtime.

fn emit_float_text_functions(compiler: write CompilerTables, ir: grow Bytes max IR_BUFFER_CAPACITY) {
    if !compiler.c_runtime { return }
    ir_write_ascii(compiler, ir, "@nl.float.pow10int = private unnamed_addr constant [20 x i64] [i64 1, i64 10, i64 100, i64 1000, i64 10000, i64 100000, i64 1000000, i64 10000000, i64 100000000, i64 1000000000, i64 10000000000, i64 100000000000, i64 1000000000000, i64 10000000000000, i64 100000000000000, i64 1000000000000000, i64 10000000000000000, i64 100000000000000000, i64 1000000000000000000, i64 -8446744073709551616], align 8\n")
    ir_write_ascii(compiler, ir, "\n")
    // Float text is plain next-lang in core/float_decimal.nl; these wrappers own the scratch memory (stack) and
    // move bits across the double/integer edge. Internal, so a program that never uses them does not carry them.
    ir_write_ascii(compiler, ir, "define internal zeroext i1 @nl_parse_double(ptr %ctx, ptr %data, i64 %len, ptr %out) {\n")
    ir_write_ascii(compiler, ir, "entry:\n")
    ir_write_ascii(compiler, ir, "  %scratch = alloca [3648 x i8], align 16\n")
    ir_write_ascii(compiler, ir, "  %bits = call i64 @nl_core_nl_float_parse(ptr %ctx, ptr %data, i64 %len, ptr %scratch)\n")
    ir_write_ascii(compiler, ir, "  %bad = icmp eq i64 %bits, 9221120237041090560\n")
    ir_write_ascii(compiler, ir, "  %safe = select i1 %bad, i64 0, i64 %bits\n")
    ir_write_ascii(compiler, ir, "  store i64 %safe, ptr %out, align 8\n")
    ir_write_ascii(compiler, ir, "  %good = xor i1 %bad, true\n")
    ir_write_ascii(compiler, ir, "  ret i1 %good\n")
    ir_write_ascii(compiler, ir, "}\n\n")
    ir_write_ascii(compiler, ir, "define internal i64 @nl_format_float_bits(ptr %ctx, i64 %bits, i64 %kind, ptr %out) {\n")
    ir_write_ascii(compiler, ir, "entry:\n")
    ir_write_ascii(compiler, ir, "  %scratch = alloca [2112 x i8], align 16\n")
    ir_write_ascii(compiler, ir, "  %n = call i64 @nl_core_nl_float_shortest(ptr %ctx, i64 %bits, i64 %kind, ptr %scratch, ptr %out)\n")
    ir_write_ascii(compiler, ir, "  ret i64 %n\n")
    ir_write_ascii(compiler, ir, "}\n\n")
    ir_write_ascii(compiler, ir, "define internal void @nl_print_float_bits(ptr %ctx, i64 %bits, i64 %kind) {\n")
    ir_write_ascii(compiler, ir, "entry:\n")
    ir_write_ascii(compiler, ir, "  %out = alloca [32 x i8], align 16\n")
    ir_write_ascii(compiler, ir, "  %n = call i64 @nl_format_float_bits(ptr %ctx, i64 %bits, i64 %kind, ptr %out)\n")
    ir_write_ascii(compiler, ir, "  call void @nlc_print_ascii(ptr %ctx, ptr %out, i64 %n)\n")
    ir_write_ascii(compiler, ir, "  call void @nlc_print_newline(ptr %ctx)\n")
    ir_write_ascii(compiler, ir, "  ret void\n")
    ir_write_ascii(compiler, ir, "}\n")
    ir_write_ascii(compiler, ir, "\n")
    ir_write_ascii(compiler, ir, "define internal i64 @nl_format_fixed(double %x, i64 %digits, ptr %out, i64 %cap) {\n")
    ir_write_ascii(compiler, ir, "entry:\n")
    ir_write_ascii(compiler, ir, "  %limbs = alloca [4 x i64], align 8\n")
    ir_write_ascii(compiler, ir, "  %buf = alloca [64 x i8], align 8\n")
    ir_write_ascii(compiler, ir, "  %cnt = alloca i64, align 8\n")
    ir_write_ascii(compiler, ir, "  %rm = alloca i64, align 8\n")
    ir_write_ascii(compiler, ir, "  %li = alloca i64, align 8\n")
    ir_write_ascii(compiler, ir, "  %k = alloca i64, align 8\n")
    ir_write_ascii(compiler, ir, "  %bits = bitcast double %x to i64\n")
    ir_write_ascii(compiler, ir, "  %neg = icmp slt i64 %bits, 0\n")
    ir_write_ascii(compiler, ir, "  %expb = lshr i64 %bits, 52\n")
    ir_write_ascii(compiler, ir, "  %expb2 = and i64 %expb, 2047\n")
    ir_write_ascii(compiler, ir, "  %frac = and i64 %bits, 4503599627370495\n")
    ir_write_ascii(compiler, ir, "  %inf = icmp eq i64 %expb2, 2047\n")
    ir_write_ascii(compiler, ir, "  %dneg = icmp slt i64 %digits, 0\n")
    ir_write_ascii(compiler, ir, "  %dbig = icmp sgt i64 %digits, 19\n")
    ir_write_ascii(compiler, ir, "  %bad0 = or i1 %inf, %dneg\n")
    ir_write_ascii(compiler, ir, "  %bad = or i1 %bad0, %dbig\n")
    ir_write_ascii(compiler, ir, "  br i1 %bad, label %fail, label %decode\n")
    ir_write_ascii(compiler, ir, "decode:\n")
    ir_write_ascii(compiler, ir, "  %normal = icmp ne i64 %expb2, 0\n")
    ir_write_ascii(compiler, ir, "  %mant_n = or i64 %frac, 4503599627370496\n")
    ir_write_ascii(compiler, ir, "  %m = select i1 %normal, i64 %mant_n, i64 %frac\n")
    ir_write_ascii(compiler, ir, "  %e_n = sub i64 %expb2, 1075\n")
    ir_write_ascii(compiler, ir, "  %e = select i1 %normal, i64 %e_n, i64 -1074\n")
    ir_write_ascii(compiler, ir, "  %mext = zext i64 %m to i128\n")
    ir_write_ascii(compiler, ir, "  %p10p = getelementptr [20 x i64], ptr @nl.float.pow10int, i64 0, i64 %digits\n")
    ir_write_ascii(compiler, ir, "  %p10 = load i64, ptr %p10p\n")
    ir_write_ascii(compiler, ir, "  %p10x = zext i64 %p10 to i128\n")
    ir_write_ascii(compiler, ir, "  %prod = mul i128 %mext, %p10x\n")
    ir_write_ascii(compiler, ir, "  %eneg = icmp slt i64 %e, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %eneg, label %frac_case, label %int_case\n")
    ir_write_ascii(compiler, ir, "int_case:\n")
    ir_write_ascii(compiler, ir, "  %etoobig = icmp sgt i64 %e, 10\n")
    ir_write_ascii(compiler, ir, "  br i1 %etoobig, label %fail, label %int_ok\n")
    ir_write_ascii(compiler, ir, "int_ok:\n")
    ir_write_ascii(compiler, ir, "  %e128 = zext i64 %e to i128\n")
    ir_write_ascii(compiler, ir, "  %shifted = shl i128 %prod, %e128\n")
    ir_write_ascii(compiler, ir, "  br label %digits_start\n")
    ir_write_ascii(compiler, ir, "frac_case:\n")
    ir_write_ascii(compiler, ir, "  %s = sub i64 0, %e\n")
    ir_write_ascii(compiler, ir, "  %s_big = icmp uge i64 %s, 118\n")
    ir_write_ascii(compiler, ir, "  br i1 %s_big, label %digits_start, label %do_shift\n")
    ir_write_ascii(compiler, ir, "do_shift:\n")
    ir_write_ascii(compiler, ir, "  %s128 = zext i64 %s to i128\n")
    ir_write_ascii(compiler, ir, "  %q = lshr i128 %prod, %s128\n")
    ir_write_ascii(compiler, ir, "  %bit = shl i128 1, %s128\n")
    ir_write_ascii(compiler, ir, "  %mask = sub i128 %bit, 1\n")
    ir_write_ascii(compiler, ir, "  %rem = and i128 %prod, %mask\n")
    ir_write_ascii(compiler, ir, "  %sm1 = sub i64 %s, 1\n")
    ir_write_ascii(compiler, ir, "  %sm1x = zext i64 %sm1 to i128\n")
    ir_write_ascii(compiler, ir, "  %half = shl i128 1, %sm1x\n")
    ir_write_ascii(compiler, ir, "  %gt = icmp ugt i128 %rem, %half\n")
    ir_write_ascii(compiler, ir, "  %eq = icmp eq i128 %rem, %half\n")
    ir_write_ascii(compiler, ir, "  %qlow = and i128 %q, 1\n")
    ir_write_ascii(compiler, ir, "  %isodd = icmp ne i128 %qlow, 0\n")
    ir_write_ascii(compiler, ir, "  %tie_up = and i1 %eq, %isodd\n")
    ir_write_ascii(compiler, ir, "  %up = or i1 %gt, %tie_up\n")
    ir_write_ascii(compiler, ir, "  %upx = zext i1 %up to i128\n")
    ir_write_ascii(compiler, ir, "  %qr = add i128 %q, %upx\n")
    ir_write_ascii(compiler, ir, "  br label %digits_start\n")
    ir_write_ascii(compiler, ir, "digits_start:\n")
    ir_write_ascii(compiler, ir, "  %n = phi i128 [ %shifted, %int_ok ], [ 0, %frac_case ], [ %qr, %do_shift ]\n")
    ir_write_ascii(compiler, ir, "  %n0 = trunc i128 %n to i64\n")
    ir_write_ascii(compiler, ir, "  %l0 = and i64 %n0, 4294967295\n")
    ir_write_ascii(compiler, ir, "  %n0s = lshr i64 %n0, 32\n")
    ir_write_ascii(compiler, ir, "  %n1 = lshr i128 %n, 64\n")
    ir_write_ascii(compiler, ir, "  %n1t = trunc i128 %n1 to i64\n")
    ir_write_ascii(compiler, ir, "  %l2 = and i64 %n1t, 4294967295\n")
    ir_write_ascii(compiler, ir, "  %l3 = lshr i64 %n1t, 32\n")
    ir_write_ascii(compiler, ir, "  %lp0 = getelementptr [4 x i64], ptr %limbs, i64 0, i64 0\n")
    ir_write_ascii(compiler, ir, "  %lp1 = getelementptr [4 x i64], ptr %limbs, i64 0, i64 1\n")
    ir_write_ascii(compiler, ir, "  %lp2 = getelementptr [4 x i64], ptr %limbs, i64 0, i64 2\n")
    ir_write_ascii(compiler, ir, "  %lp3 = getelementptr [4 x i64], ptr %limbs, i64 0, i64 3\n")
    ir_write_ascii(compiler, ir, "  store i64 %l0, ptr %lp0\n")
    ir_write_ascii(compiler, ir, "  store i64 %n0s, ptr %lp1\n")
    ir_write_ascii(compiler, ir, "  store i64 %l2, ptr %lp2\n")
    ir_write_ascii(compiler, ir, "  store i64 %l3, ptr %lp3\n")
    ir_write_ascii(compiler, ir, "  store i64 0, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  br label %chunk_loop\n")
    ir_write_ascii(compiler, ir, "chunk_loop:\n")
    ir_write_ascii(compiler, ir, "  store i64 0, ptr %rm\n")
    ir_write_ascii(compiler, ir, "  store i64 3, ptr %li\n")
    ir_write_ascii(compiler, ir, "  br label %div_loop\n")
    ir_write_ascii(compiler, ir, "div_loop:\n")
    ir_write_ascii(compiler, ir, "  %i = load i64, ptr %li\n")
    ir_write_ascii(compiler, ir, "  %lp = getelementptr [4 x i64], ptr %limbs, i64 0, i64 %i\n")
    ir_write_ascii(compiler, ir, "  %lv = load i64, ptr %lp\n")
    ir_write_ascii(compiler, ir, "  %r0 = load i64, ptr %rm\n")
    ir_write_ascii(compiler, ir, "  %cur0 = shl i64 %r0, 32\n")
    ir_write_ascii(compiler, ir, "  %cur = or i64 %cur0, %lv\n")
    ir_write_ascii(compiler, ir, "  %qq = udiv i64 %cur, 1000000000\n")
    ir_write_ascii(compiler, ir, "  %rr = urem i64 %cur, 1000000000\n")
    ir_write_ascii(compiler, ir, "  store i64 %qq, ptr %lp\n")
    ir_write_ascii(compiler, ir, "  store i64 %rr, ptr %rm\n")
    ir_write_ascii(compiler, ir, "  %in = sub i64 %i, 1\n")
    ir_write_ascii(compiler, ir, "  store i64 %in, ptr %li\n")
    ir_write_ascii(compiler, ir, "  %dmore = icmp sge i64 %in, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %dmore, label %div_loop, label %emit_chunk\n")
    ir_write_ascii(compiler, ir, "emit_chunk:\n")
    ir_write_ascii(compiler, ir, "  store i64 0, ptr %k\n")
    ir_write_ascii(compiler, ir, "  br label %dig_loop\n")
    ir_write_ascii(compiler, ir, "dig_loop:\n")
    ir_write_ascii(compiler, ir, "  %kk = load i64, ptr %k\n")
    ir_write_ascii(compiler, ir, "  %rc = load i64, ptr %rm\n")
    ir_write_ascii(compiler, ir, "  %dm = urem i64 %rc, 10\n")
    ir_write_ascii(compiler, ir, "  %dq = udiv i64 %rc, 10\n")
    ir_write_ascii(compiler, ir, "  store i64 %dq, ptr %rm\n")
    ir_write_ascii(compiler, ir, "  %ch = add i64 %dm, 48\n")
    ir_write_ascii(compiler, ir, "  %ch8 = trunc i64 %ch to i8\n")
    ir_write_ascii(compiler, ir, "  %c = load i64, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  %bp = getelementptr [64 x i8], ptr %buf, i64 0, i64 %c\n")
    ir_write_ascii(compiler, ir, "  store i8 %ch8, ptr %bp\n")
    ir_write_ascii(compiler, ir, "  %c2 = add i64 %c, 1\n")
    ir_write_ascii(compiler, ir, "  store i64 %c2, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  %kk2 = add i64 %kk, 1\n")
    ir_write_ascii(compiler, ir, "  store i64 %kk2, ptr %k\n")
    ir_write_ascii(compiler, ir, "  %kd = icmp ult i64 %kk2, 9\n")
    ir_write_ascii(compiler, ir, "  br i1 %kd, label %dig_loop, label %check_zero\n")
    ir_write_ascii(compiler, ir, "check_zero:\n")
    ir_write_ascii(compiler, ir, "  %z0 = load i64, ptr %lp0\n")
    ir_write_ascii(compiler, ir, "  %z1 = load i64, ptr %lp1\n")
    ir_write_ascii(compiler, ir, "  %z2 = load i64, ptr %lp2\n")
    ir_write_ascii(compiler, ir, "  %z3 = load i64, ptr %lp3\n")
    ir_write_ascii(compiler, ir, "  %za = or i64 %z0, %z1\n")
    ir_write_ascii(compiler, ir, "  %zb = or i64 %z2, %z3\n")
    ir_write_ascii(compiler, ir, "  %zc = or i64 %za, %zb\n")
    ir_write_ascii(compiler, ir, "  %nonzero = icmp ne i64 %zc, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %nonzero, label %chunk_loop, label %trim_loop\n")
    ir_write_ascii(compiler, ir, "trim_loop:\n")
    ir_write_ascii(compiler, ir, "  %tc = load i64, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  %tbig = icmp ugt i64 %tc, 1\n")
    ir_write_ascii(compiler, ir, "  %tcm1 = sub i64 %tc, 1\n")
    ir_write_ascii(compiler, ir, "  %tp = getelementptr [64 x i8], ptr %buf, i64 0, i64 %tcm1\n")
    ir_write_ascii(compiler, ir, "  %tv = load i8, ptr %tp\n")
    ir_write_ascii(compiler, ir, "  %tz = icmp eq i8 %tv, 48\n")
    ir_write_ascii(compiler, ir, "  %tgo = and i1 %tbig, %tz\n")
    ir_write_ascii(compiler, ir, "  br i1 %tgo, label %trim_step, label %pad_loop\n")
    ir_write_ascii(compiler, ir, "trim_step:\n")
    ir_write_ascii(compiler, ir, "  store i64 %tcm1, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  br label %trim_loop\n")
    ir_write_ascii(compiler, ir, "pad_loop:\n")
    ir_write_ascii(compiler, ir, "  %pc = load i64, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  %need = add i64 %digits, 1\n")
    ir_write_ascii(compiler, ir, "  %short = icmp slt i64 %pc, %need\n")
    ir_write_ascii(compiler, ir, "  br i1 %short, label %pad_step, label %assemble\n")
    ir_write_ascii(compiler, ir, "pad_step:\n")
    ir_write_ascii(compiler, ir, "  %pbp = getelementptr [64 x i8], ptr %buf, i64 0, i64 %pc\n")
    ir_write_ascii(compiler, ir, "  store i8 48, ptr %pbp\n")
    ir_write_ascii(compiler, ir, "  %pc2 = add i64 %pc, 1\n")
    ir_write_ascii(compiler, ir, "  store i64 %pc2, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  br label %pad_loop\n")
    ir_write_ascii(compiler, ir, "assemble:\n")
    ir_write_ascii(compiler, ir, "  %count = load i64, ptr %cnt\n")
    ir_write_ascii(compiler, ir, "  %intdigits = sub i64 %count, %digits\n")
    ir_write_ascii(compiler, ir, "  %negx = zext i1 %neg to i64\n")
    ir_write_ascii(compiler, ir, "  %hasdot = icmp sgt i64 %digits, 0\n")
    ir_write_ascii(compiler, ir, "  %dotx = zext i1 %hasdot to i64\n")
    ir_write_ascii(compiler, ir, "  %t1 = add i64 %negx, %intdigits\n")
    ir_write_ascii(compiler, ir, "  %t2 = add i64 %t1, %dotx\n")
    ir_write_ascii(compiler, ir, "  %total = add i64 %t2, %digits\n")
    ir_write_ascii(compiler, ir, "  %toolong = icmp sgt i64 %total, %cap\n")
    ir_write_ascii(compiler, ir, "  br i1 %toolong, label %fail, label %write_sign\n")
    ir_write_ascii(compiler, ir, "write_sign:\n")
    ir_write_ascii(compiler, ir, "  br i1 %neg, label %put_minus, label %int_start\n")
    ir_write_ascii(compiler, ir, "put_minus:\n")
    ir_write_ascii(compiler, ir, "  store i8 45, ptr %out\n")
    ir_write_ascii(compiler, ir, "  br label %int_start\n")
    ir_write_ascii(compiler, ir, "int_start:\n")
    ir_write_ascii(compiler, ir, "  %o0 = phi i64 [ 0, %write_sign ], [ 1, %put_minus ]\n")
    ir_write_ascii(compiler, ir, "  br label %int_loop\n")
    ir_write_ascii(compiler, ir, "int_loop:\n")
    ir_write_ascii(compiler, ir, "  %ii = phi i64 [ %count, %int_start ], [ %ii1, %int_loop_body ]\n")
    ir_write_ascii(compiler, ir, "  %oo = phi i64 [ %o0, %int_start ], [ %oo1, %int_loop_body ]\n")
    ir_write_ascii(compiler, ir, "  %ii_more = icmp sgt i64 %ii, %digits\n")
    ir_write_ascii(compiler, ir, "  br i1 %ii_more, label %int_loop_body, label %dot_check\n")
    ir_write_ascii(compiler, ir, "int_loop_body:\n")
    ir_write_ascii(compiler, ir, "  %ii1 = sub i64 %ii, 1\n")
    ir_write_ascii(compiler, ir, "  %sp = getelementptr [64 x i8], ptr %buf, i64 0, i64 %ii1\n")
    ir_write_ascii(compiler, ir, "  %sv = load i8, ptr %sp\n")
    ir_write_ascii(compiler, ir, "  %dp = getelementptr i8, ptr %out, i64 %oo\n")
    ir_write_ascii(compiler, ir, "  store i8 %sv, ptr %dp\n")
    ir_write_ascii(compiler, ir, "  %oo1 = add i64 %oo, 1\n")
    ir_write_ascii(compiler, ir, "  br label %int_loop\n")
    ir_write_ascii(compiler, ir, "dot_check:\n")
    ir_write_ascii(compiler, ir, "  br i1 %hasdot, label %put_dot, label %done\n")
    ir_write_ascii(compiler, ir, "put_dot:\n")
    ir_write_ascii(compiler, ir, "  %dotp = getelementptr i8, ptr %out, i64 %oo\n")
    ir_write_ascii(compiler, ir, "  store i8 46, ptr %dotp\n")
    ir_write_ascii(compiler, ir, "  %oo2 = add i64 %oo, 1\n")
    ir_write_ascii(compiler, ir, "  br label %frac_loop\n")
    ir_write_ascii(compiler, ir, "frac_loop:\n")
    ir_write_ascii(compiler, ir, "  %fi = phi i64 [ %digits, %put_dot ], [ %fi1, %frac_body ]\n")
    ir_write_ascii(compiler, ir, "  %fo = phi i64 [ %oo2, %put_dot ], [ %fo1, %frac_body ]\n")
    ir_write_ascii(compiler, ir, "  %fmore = icmp sgt i64 %fi, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %fmore, label %frac_body, label %done\n")
    ir_write_ascii(compiler, ir, "frac_body:\n")
    ir_write_ascii(compiler, ir, "  %fi1 = sub i64 %fi, 1\n")
    ir_write_ascii(compiler, ir, "  %fsp = getelementptr [64 x i8], ptr %buf, i64 0, i64 %fi1\n")
    ir_write_ascii(compiler, ir, "  %fsv = load i8, ptr %fsp\n")
    ir_write_ascii(compiler, ir, "  %fdp = getelementptr i8, ptr %out, i64 %fo\n")
    ir_write_ascii(compiler, ir, "  store i8 %fsv, ptr %fdp\n")
    ir_write_ascii(compiler, ir, "  %fo1 = add i64 %fo, 1\n")
    ir_write_ascii(compiler, ir, "  br label %frac_loop\n")
    ir_write_ascii(compiler, ir, "done:\n")
    ir_write_ascii(compiler, ir, "  ret i64 %total\n")
    ir_write_ascii(compiler, ir, "fail:\n")
    ir_write_ascii(compiler, ir, "  ret i64 -1\n")
    ir_write_ascii(compiler, ir, "}\n")
}

// %fp.bits.<node> = the IEEE bits of the double or float value of `argument` as an i64 (a float in the low 32 bits).
fn emit_float_bits_i64(compiler: write CompilerTables, ir: grow Bytes max IR_BUFFER_CAPACITY, node: long, argument: long) {
    if compiler.facts[argument].ty == TY_FLOAT {
        ir_write_ascii(compiler, ir, "  %fp.narrow."); ir_write_number(compiler, ir, node); ir_write_ascii(compiler, ir, " = bitcast float "); ir_write_value_ref(compiler, ir, argument); ir_write_ascii(compiler, ir, " to i32\n")
        ir_write_ascii(compiler, ir, "  %fp.bits."); ir_write_number(compiler, ir, node); ir_write_ascii(compiler, ir, " = zext i32 %fp.narrow."); ir_write_number(compiler, ir, node); ir_write_ascii(compiler, ir, " to i64\n")
    } else {
        ir_write_ascii(compiler, ir, "  %fp.bits."); ir_write_number(compiler, ir, node); ir_write_ascii(compiler, ir, " = bitcast double "); ir_write_value_ref(compiler, ir, argument); ir_write_ascii(compiler, ir, " to i64\n")
    }
}
