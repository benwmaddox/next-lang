// The C runtime lists a directory with all the names first and the kinds after them (the layout the frozen
// stage 0 uses). A list of DirEntry here is one plain record per entry (the name, then the kind padded to 8
// bytes), so the listing is rearranged in place: the kinds are saved, then the names move up, last first, so
// no entry is overwritten before it has moved.

fn emit_c_runtime_list_with_extension(compiler: write CompilerTables, ir: grow Bytes max IR_BUFFER_CAPACITY) {
    ir_write_ascii(compiler, ir, "define void @nlc_fs_list_with_extension(ptr %nl.ctx, ptr %fs, ptr %path, i32 %path.kind, i64 %path.capacity, ptr %extension, i64 %extension.length, ptr %output, i64 %capacity, ptr %result) {\n")
    ir_write_ascii(compiler, ir, "entry:\n")
    ir_write_ascii(compiler, ir, "  %kinds.tmp = alloca [4096 x i32], align 4\n")
    ir_write_ascii(compiler, ir, "  call void @nl_fs_list_with_extension(ptr %fs, ptr %path, i32 %path.kind, i64 %path.capacity, ptr %extension, i64 %extension.length, ptr %output, i64 %capacity, ptr %result)\n")
    ir_write_ascii(compiler, ir, "  %status = load i32, ptr %result, align 1\n")
    ir_write_ascii(compiler, ir, "  %failed = icmp ne i32 %status, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %failed, label %list.done, label %list.convert\n")
    ir_write_ascii(compiler, ir, "list.convert:\n")
    ir_write_ascii(compiler, ir, "  %count = load i64, ptr %output, align 1\n")
    ir_write_ascii(compiler, ir, "  %kinds.src.base = mul i64 %capacity, 16392\n")
    ir_write_ascii(compiler, ir, "  %kinds.src.off = add i64 %kinds.src.base, 8\n")
    ir_write_ascii(compiler, ir, "  %kinds.src = getelementptr i8, ptr %output, i64 %kinds.src.off\n")
    ir_write_ascii(compiler, ir, "  %kinds.bytes = mul i64 %count, 4\n")
    ir_write_ascii(compiler, ir, "  %kinds.copy = call ptr @memcpy(ptr %kinds.tmp, ptr %kinds.src, i64 %kinds.bytes)\n")
    ir_write_ascii(compiler, ir, "  %has = icmp ne i64 %count, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %has, label %move.start, label %list.done\n")
    ir_write_ascii(compiler, ir, "move.start:\n")
    ir_write_ascii(compiler, ir, "  %last = sub i64 %count, 1\n")
    ir_write_ascii(compiler, ir, "  br label %move.cond\n")
    ir_write_ascii(compiler, ir, "move.cond:\n")
    ir_write_ascii(compiler, ir, "  %mi = phi i64 [ %last, %move.start ], [ %mi.prev, %move.next ]\n")
    ir_write_ascii(compiler, ir, "  %src.off0 = mul i64 %mi, 16392\n")
    ir_write_ascii(compiler, ir, "  %src.off = add i64 %src.off0, 8\n")
    ir_write_ascii(compiler, ir, "  %dst.off0 = mul i64 %mi, 16400\n")
    ir_write_ascii(compiler, ir, "  %dst.off = add i64 %dst.off0, 8\n")
    ir_write_ascii(compiler, ir, "  %src = getelementptr i8, ptr %output, i64 %src.off\n")
    ir_write_ascii(compiler, ir, "  %dst = getelementptr i8, ptr %output, i64 %dst.off\n")
    ir_write_ascii(compiler, ir, "  %len = load i64, ptr %src, align 1\n")
    ir_write_ascii(compiler, ir, "  %len4 = mul i64 %len, 4\n")
    ir_write_ascii(compiler, ir, "  %live = add i64 %len4, 8\n")
    ir_write_ascii(compiler, ir, "  %moved = call ptr @memmove(ptr %dst, ptr %src, i64 %live)\n")
    ir_write_ascii(compiler, ir, "  %kp = getelementptr i32, ptr %kinds.tmp, i64 %mi\n")
    ir_write_ascii(compiler, ir, "  %kv = load i32, ptr %kp, align 4\n")
    ir_write_ascii(compiler, ir, "  %kd.off = add i64 %dst.off, 16392\n")
    ir_write_ascii(compiler, ir, "  %kd = getelementptr i8, ptr %output, i64 %kd.off\n")
    ir_write_ascii(compiler, ir, "  store i32 %kv, ptr %kd, align 1\n")
    ir_write_ascii(compiler, ir, "  %at.first = icmp eq i64 %mi, 0\n")
    ir_write_ascii(compiler, ir, "  br i1 %at.first, label %list.done, label %move.next\n")
    ir_write_ascii(compiler, ir, "move.next:\n")
    ir_write_ascii(compiler, ir, "  %mi.prev = sub i64 %mi, 1\n")
    ir_write_ascii(compiler, ir, "  br label %move.cond\n")
    ir_write_ascii(compiler, ir, "list.done:\n")
    ir_write_ascii(compiler, ir, "  ret void\n")
    ir_write_ascii(compiler, ir, "}\n")
    ir_write_ascii(compiler, ir, "\n")
}
