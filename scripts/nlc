#!/usr/bin/env bash
# Driver for the self-hosted compiler: compile to LLVM IR with nlc-selfhost, then link with clang.
#   nlc build <package> [-o out] [--runtime=c|core]   compile and link a program
#   nlc run   <package> [-- args...]                   build into a temporary directory and run
#   nlc test  <package>                                build in test mode and run every test
#   nlc link  <file.ll> -o out                         link IR the compiler already wrote
# NLC_SELFHOST names the compiler (default: nlc-selfhost next to this script, then in ../); NLC_RUNTIME_DIR
# names the directory holding nl_runtime.c (default: ../runtime or ./runtime next to the script);
# NLC_OPT_LEVEL is 1 (default) or 3. The package path must be relative to the current directory (the
# compiler's file access is confined beneath it), and the output may be anywhere.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_compiler() {
    if [[ -n "${NLC_SELFHOST:-}" ]]; then echo "$NLC_SELFHOST"; return; fi
    for candidate in "$here/nlc-selfhost" "$here/../nlc-selfhost" "$here/../.selfhost-stage-chain-aos/stage3"; do
        if [[ -x "$candidate" ]]; then echo "$candidate"; return; fi
    done
    echo "nlc: cannot find the self-hosted compiler; set NLC_SELFHOST" >&2
    exit 2
}

find_runtime() {
    if [[ -n "${NLC_RUNTIME_DIR:-}" ]]; then echo "$NLC_RUNTIME_DIR"; return; fi
    for candidate in "$here/../runtime" "$here/runtime"; do
        if [[ -f "$candidate/nl_runtime.c" ]]; then echo "$candidate"; return; fi
    done
    echo "nlc: cannot find runtime/nl_runtime.c; set NLC_RUNTIME_DIR" >&2
    exit 2
}

# clang prints warnings about the IR's target triple on success; show its output only when it fails.
quiet_clang() {
    local log status=0
    log="$(mktemp "${TMPDIR:-/tmp}/nlc-clang.XXXXXX")"
    clang "$@" > "$log" 2>&1 || status=$?
    if [[ $status -ne 0 ]]; then
        echo "nlc: tool failure: clang failed" >&2
        cat "$log" >&2
    fi
    rm -f "$log"
    return $status
}

# link <ll> <output>: read the "; nlc.*" header and run clang the way the Rust driver does.
link() {
    local ir="$1" output="$2"
    local runtime="c" build="" stack=""   # IR from before the runtime line existed is C-runtime IR
    while IFS= read -r line; do
        case "$line" in
            "; nlc.runtime "*) runtime="${line#; nlc.runtime }" ;;
            "; nlc.build "*) build="${line#; nlc.build }" ;;
            "; nlc.stack "*) stack="${line#; nlc.stack }" ;;
            "; "*) ;;
            *) break ;;
        esac
    done < "$ir"
    local flags=("-O${NLC_OPT_LEVEL:-1}")
    if [[ "$runtime" == "c" ]]; then
        [[ "$build" == "test" ]] && flags+=("-DNLC_TEST_BUILD=1")
        [[ "$stack" == "offset" ]] && flags+=("-DNLC_STACK_MODE_OFFSET=1")
        local runtime_dir; runtime_dir="$(find_runtime)"
        if grep -qE 'call (void|i64) @nl_db_(query|text|row)' "$ir"; then
            # Env.db_query: SQLite is compiled once into the cache and linked in.
            local cache="${NLC_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/next-lang}" object
            mkdir -p "$cache"
            object="$cache/sqlite3-3500400.o"
            if [[ ! -f "$object" ]]; then
                quiet_clang -O2 -c -DSQLITE_THREADSAFE=2 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DQS=0 -DSQLITE_DEFAULT_MEMSTATUS=0 \
                    "$runtime_dir/sqlite/sqlite3.c" -o "$object.$$" && mv "$object.$$" "$object"
            fi
            quiet_clang "${flags[@]}" -DNLC_WITH_DB=1 -I"$runtime_dir/sqlite" "$ir" "$runtime_dir/nl_runtime.c" "$object" -lpthread -lm -o "$output"
        else
            quiet_clang "${flags[@]}" "$ir" "$runtime_dir/nl_runtime.c" -o "$output"
        fi
    elif [[ "$runtime" == "core" ]]; then
        flags+=(-nostdlib -static -Wl,-e,_start -Wl,-no-pie -Wl,--build-id=none)
        quiet_clang "${flags[@]}" "$ir" -o "$output"
    else
        echo "nlc: $ir has no '; nlc.runtime' header line" >&2
        exit 2
    fi
}

# The SQLite object, compiled once into the cache.
sqlite_object() {
    local runtime_dir cache object
    runtime_dir="$(find_runtime)"
    cache="${NLC_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/next-lang}"
    mkdir -p "$cache"
    object="$cache/sqlite3-3500400.o"
    if [[ ! -f "$object" ]]; then
        quiet_clang -O2 -c -DSQLITE_THREADSAFE=2 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DQS=0 -DSQLITE_DEFAULT_MEMSTATUS=0 \
            "$runtime_dir/sqlite/sqlite3.c" -o "$object.$$" && mv "$object.$$" "$object"
    fi
    echo "$object"
}

# check_queries <ll> <package>: prepare every Env.db_row query against <package>/schema.sql, so a wrong table, column
# or type is an error when the program is built. A package with queries and no schema.sql only gets a warning.
check_queries() {
    local ir="$1" package="$2" runtime_dir cache checker schema
    grep -q '^; nlc.query ' "$ir" || return 0
    schema="$package/schema.sql"
    if [[ ! -f "$schema" ]]; then
        echo "nlc: warning: the queries in this program are not checked; add $schema to check them when it is built" >&2
        return 0
    fi
    runtime_dir="$(find_runtime)"
    cache="${NLC_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/next-lang}"
    checker="$cache/querycheck"
    if [[ ! -x "$checker" || "$runtime_dir/querycheck.c" -nt "$checker" ]]; then
        quiet_clang -O1 -I"$runtime_dir/sqlite" "$runtime_dir/querycheck.c" "$(sqlite_object)" -lpthread -lm -o "$checker.$$" && mv "$checker.$$" "$checker"
    fi
    sed -n 's/^; nlc.query //p' "$ir" | "$checker" "$schema"
}

# compile <package> <ll> <extra compiler flags...>: the C runtime unless a --runtime flag says otherwise.
compile() {
    local package="$1" ir="$2"
    shift 2
    local runtime="--runtime=c" flags=()
    for flag in "$@"; do
        case "$flag" in --runtime=*) runtime="$flag" ;; *) flags+=("$flag") ;; esac
    done
    "$(find_compiler)" build "$package" -o "$ir" "$runtime" "${flags[@]}"
}

# run_test_ir <ll> <workdir>: link a test-mode IR file and run each test in its own process, printing
# "ok   name" / "FAIL name", the test's output, and a summary, as the Rust driver's test-ir did.
run_test_ir() {
    local ir="$1" work="$2"
    local names=() passed=0 failed=0 line rest hex index name code
    while IFS= read -r line; do
        case "$line" in
            "; nlc.test "*)
                rest="${line#; nlc.test }"
                hex="${rest#* }"
                names+=("$(printf "$(echo "$hex" | sed 's/../\\x&/g')")")
                ;;
            "; "*) ;;
            *) break ;;
        esac
    done < "$ir"
    if [[ ${#names[@]} -eq 0 ]]; then echo "0 passed, 0 failed"; return 0; fi
    link "$ir" "$work/tests"
    passed=0 failed=0
    for index in "${!names[@]}"; do
        name="${names[$index]}"
        set +e
        { NLC_TEST_INDEX="$index" "$work/tests" > "$work/out" 2> "$work/err"; code=$?; } 2>/dev/null
        set -e
        if [[ $code -eq 0 ]]; then echo "ok   $name"; passed=$((passed + 1)); else
            echo "FAIL $name"; failed=$((failed + 1))
            [[ $code -eq 70 ]] && echo "  test '$name' ended with a runtime failure (exit code 70)"
            if [[ $code -gt 128 ]]; then echo "  test '$name' terminated abnormally"
            elif [[ $code -ne 1 && $code -ne 70 ]]; then echo "  test '$name' exited with code $code"; fi
        fi
        cat "$work/out"
        cat "$work/err" >&2
    done
    echo "$passed passed, $failed failed"
    [[ $failed -eq 0 ]]
}

command="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command" in
    build)
        package="" output="" extra=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -o) output="$2"; shift 2 ;;
                --runtime=*) extra+=("$1"); shift ;;
                *) package="$1"; shift ;;
            esac
        done
        [[ -n "$package" ]] || { echo "usage: nlc build <package> [-o out] [--runtime=c|core]" >&2; exit 2; }
        output="${output:-$(basename "$package")}"
        # The compiler reads and writes only beneath the current directory, so the IR goes there.
        ir=".nlc-build-$$.ll"
        trap 'rm -f "$ir"' EXIT
        compile "$package" "$ir" "${extra[@]}"
        check_queries "$ir" "$package"
        link "$ir" "$output"
        ;;
    run)
        package="${1:?usage: nlc run <package> [-- args...]}"
        shift
        [[ "${1:-}" == "--" ]] && shift
        work="$(mktemp -d ./.nlc-run.XXXXXX)"
        trap 'rm -rf "$work"' EXIT
        compile "$package" "$work/program.ll"
        check_queries "$work/program.ll" "$package"
        link "$work/program.ll" "$work/program"
        "$work/program" "$@"
        ;;
    test)
        package="${1:?usage: nlc test <package>}"
        work="$(mktemp -d ./.nlc-test.XXXXXX)"
        trap 'rm -rf "$work"' EXIT
        compile "$package" "$work/tests.ll" --test
        run_test_ir "$work/tests.ll" "$work"
        ;;
    test-ir)
        ir="${1:?usage: nlc test-ir <file.ll>}"
        work="$(mktemp -d "${TMPDIR:-/tmp}/nlc-test.XXXXXX")"
        trap 'rm -rf "$work"' EXIT
        run_test_ir "$ir" "$work"
        ;;
    link-ir|link)
        ir="${1:?usage: nlc link <file.ll> -o out}"
        [[ "${2:-}" == "-o" ]] || { echo "usage: nlc link <file.ll> -o out" >&2; exit 2; }
        link "$ir" "${3:?missing output}"
        ;;
    *)
        echo "usage: nlc build|run|test|test-ir|link ... (see the header of this script)" >&2
        exit 2
        ;;
esac
